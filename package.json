{
  "name": "ai-reels-pipeline",
  "version": "0.1.0",
  "description": "End-to-end AI short-video pipeline: source, transcribe, script, voice, render and auto-publish to Instagram.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "get-instagram-content": "node --env-file=.env index.cjs",
    "ffcreator": "node --env-file=.env ffcreator-video.cjs",
    "check": "for f in *.cjs; do node --check \"$f\" || exit 1; done"
  },
  "dependencies": {
    "aws-sdk": "^2.1370.0",
    "axios": "^1.4.0",
    "elevenlabs-node": "^1.1.0",
    "ffcreator": "^7.2.2",
    "fluent-ffmpeg": "^2.1.2",
    "form-data": "^4.0.0",
    "get-audio-duration": "^4.0.1-beta.0",
    "gl": "^6.0.2",
    "instagram-private-api": "^1.45.3",
    "nan": "^2.17.0",
    "node-canvas": "^2.9.0",
    "subtitle": "^4.2.1",
    "uuid": "^9.0.0"
  }
}
